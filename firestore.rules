rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      // These docs are written ONLY by the bot's Admin SDK path (which bypasses these
      // rules entirely). The client may READ them (Settings shows link status, prefs,
      // last batch), but must never WRITE them, or a buggy/malicious client script
      // could fake state the bot trusts:
      //   meta/botLinks       — a forged "linked" state
      //   meta/botPending     — a forged pending transaction/goal draft
      //   meta/botLastBatch   — a forged /undo target (delete arbitrary transactions)
      //   meta/botPrefs       — flip alwaysReview / autoAcceptConfidence out of band
      //   meta/botModelDay    — zero out the per-user daily AI-call counter
      //   bot_receipt_cache/* — plant a receipt read (merchant, Drive link) the bot stamps on a tx
      //   bot_parse_cache/*   — plant parsed transaction lines returned on the next matching message
      // `meta/scan_hints` is intentionally NOT in this list — the web receipt scanner
      // writes it via the client SDK.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && !(document.size() == 2 && document[0] == 'meta'
                        && (document[1] == 'botLinks' || document[1] == 'botPending'
                            || document[1] == 'botLastBatch' || document[1] == 'botPrefs'
                            || document[1] == 'botModelDay'))
                   && !(document[0] == 'bot_receipt_cache' || document[0] == 'bot_parse_cache');
    }

    // Root collections used only by the bot's server-side (Admin SDK) code — never
    // read or written by the client. Admin SDK access bypasses these rules, so this
    // is a deny-all for every other caller.
    match /bot_links/{linkId} {
      allow read, write: if false;
    }
    match /bot_link_codes/{codeId} {
      allow read, write: if false;
    }
    match /bot_meta/{doc} {
      allow read, write: if false;
    }
    match /bot_processed_messages/{doc} {
      allow read, write: if false;
    }
  }
}
