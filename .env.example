# Canonical production URL — used for sitemap.xml, robots.txt, and OpenGraph/canonical
# tags (metadataBase). No trailing slash. Falls back to Vercel's own deployment URL if
# unset, then localhost — safe to leave empty for local dev.
NEXT_PUBLIC_APP_URL=

# Firebase — https://console.firebase.google.com → Project settings → Your apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini Vision — https://aistudio.google.com/app/apikey (server-side only, never NEXT_PUBLIC_)
GEMINI_API_KEY=

# Google Drive storage — Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web).
# Enable the Google Drive API and add the scope https://www.googleapis.com/auth/drive.file
# to the OAuth consent screen. Receipts are stored in the user's own Drive, so without
# this the receipt upload and AI scanner cannot save images.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The same OAuth 2.0 Web Client's secret (same Credentials page as above, "Client secret").
# Server-only — NEVER prefix this with NEXT_PUBLIC_, or it ships in the browser bundle.
# Used to exchange a one-time Drive consent for a refresh token, so a linked user is
# never asked for Drive access again (see /api/auth/google-drive/*).
GOOGLE_CLIENT_SECRET=

# Encrypts the stored Drive refresh token at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 hex characters (32 bytes). Server-only. Losing/rotating this invalidates every
# existing Drive link — users just re-click "Tautkan Google Drive" once, no data lost.
TOKEN_ENCRYPTION_KEY=

# goldapi.io key for the Market Pulse gold price widget (optional)
GOLD_API_KEY=

# Market Pulse reference values — BI Rate, inflation (YoY), and SBN retail yield have no
# usable public API (confirmed by probe: BI's endpoint doesn't resolve, BPS needs a
# registered key, DJPPR has no public REST API). Override the built-in fallback here by
# hand as real figures change; _AS_OF is shown in the UI so the number never looks live
# when it is not. All optional.
NEXT_PUBLIC_BI_RATE_OVERRIDE=
NEXT_PUBLIC_BI_RATE_AS_OF=
NEXT_PUBLIC_INFLATION_RATE_OVERRIDE=
NEXT_PUBLIC_INFLATION_RATE_AS_OF=
NEXT_PUBLIC_SBN_RATE_OVERRIDE=
NEXT_PUBLIC_SBN_RATE_AS_OF=

# ── WhatsApp/Telegram bot integration ──────────────────────────────────────
# See implementation_bot_integration.md for full setup steps. Not one of these may be
# prefixed NEXT_PUBLIC_ — they are server-only, read by the webhook routes and the bot's
# own Admin-SDK Firestore access, never by the browser.

# Telegram — from @BotFather (free): chat it, /newbot, follow the prompts, copy the token.
TELEGRAM_BOT_TOKEN=
# Any random string you choose; sent back by Telegram on every webhook call so the route
# can verify the request actually came from Telegram. Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API — Meta for Developers (free, Test Business Account, up to 5 numbers,
# no business verification required).
# MUST be a System User permanent token (Business Settings → System Users → Generate New
# Token, permission whatsapp_business_messaging) — the token shown on the API Setup page
# expires in under 24 hours and will silently stop working the next day.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Settings → Basic → App Secret. Verifies the X-Hub-Signature-256 header on every
# incoming webhook call.
META_APP_SECRET=
# Any random string you choose; used once during the webhook GET handshake in Meta's
# dashboard (Callback URL verification).
META_VERIFY_TOKEN=

# Firebase Admin SDK — Project settings → Service accounts → Generate new private key.
# Needed because the bot's webhooks have no browser session/ID token to carry — this is
# the one place in the app that reads/writes Firestore with a service account instead of
# per-user REST calls. Keep this key out of git; rotate immediately if it ever leaks.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the downloaded JSON as-is, including the escaped \n
# sequences — do not convert them to real newlines.
FIREBASE_PRIVATE_KEY=
